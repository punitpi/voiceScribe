# Server Configuration
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=./data/voicescribe.db

# Sarvam AI (replaces OpenAI Whisper for transcription — Saaras v3 model)
SARVAM_API_KEY=your-sarvam-api-key-here

# OpenAI API (kept for other potential uses, not used for transcription)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=VoiceScribe <noreply@voicescribe.app>

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Frontend URL
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
