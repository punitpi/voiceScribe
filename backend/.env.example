# Server Configuration
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=./data/voicescribe.db
TURSO_URL=file:./data/voicescribe.db   # Use libsql://your-db.turso.io for cloud
TURSO_AUTH_TOKEN=                       # Required when using remote Turso URL

# Sarvam AI (replaces OpenAI Whisper for transcription — Saaras v3 model)
SARVAM_API_KEY=your-sarvam-api-key-here

# OpenAI API (kept for other potential uses, not used for transcription)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=VoiceScribe <noreply@voicescribe.app>

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Frontend URL
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Auth (JWT — required)
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-different-secret

# Redis / Job Queue
REDIS_URL=redis://localhost:6379

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Admin seed user (created on first startup if no users exist)
ADMIN_EMAIL=admin@voicescribe.local
ADMIN_PASSWORD=changeme123
